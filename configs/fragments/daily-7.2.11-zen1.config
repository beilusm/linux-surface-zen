# Keep the Arch Zen driver baseline. No localmodconfig or device whitelist.
CONFIG_LOCALVERSION="-surface-zen"
# CONFIG_LOCALVERSION_AUTO is not set
# The host lacks rust-src/rust-bindgen. Arch's C Binder remains available.
# CONFIG_RUST is not set
CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_DRM_PANIC_SCREEN="user"
# Avoid the camera GPIO numbering collision in the Surface patch.
CONFIG_PINCTRL_ICELAKE=y
CONFIG_GPIO_TPS68470=m
# Retain DWARF5/BTF for systemd, BPF and external modules.
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# GCC without LTO keeps link time and peak memory manageable.
CONFIG_LTO_NONE=y
# Preserve the previous local AF_ALG AEAD exclusion during the kernel update.
# CONFIG_CRYPTO_USER_API_AEAD is not set
